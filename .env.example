# Copy to .env and adjust before `docker compose up` for anything beyond a
# local trial. The defaults here match docker-compose.yml's bundled Postgres
# and MinIO exactly, so `docker compose up` works with no changes.

# Required to create the first admin account when set; leave blank to allow
# anyone who reaches a fresh deploy to claim it (fine for a local trial,
# not for anything internet-reachable).
CLIPFOLIO_SETUP_TOKEN=

# --- Everything below is only relevant if you're not using docker-compose's
# --- bundled Postgres/MinIO - e.g. pointing at a real S3 bucket in production.

# CLIPFOLIO_DATABASE_URL=postgres://user:password@host:5432/clipfolio?sslmode=disable

# CLIPFOLIO_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# CLIPFOLIO_S3_REGION=us-east-1
# CLIPFOLIO_S3_BUCKET=your-bucket
# CLIPFOLIO_S3_ACCESS_KEY=
# CLIPFOLIO_S3_SECRET_KEY=
# CLIPFOLIO_S3_FORCE_PATH_STYLE=false
# CLIPFOLIO_S3_PUBLIC_BASE_URL=https://your-cdn.example.com
